# Copy to .env for local development. Placeholders only: never commit real values.
# In production these are set as Coolify environment variables.

# Public origins
SITE_ORIGIN=https://grid.example.org
CMS_ORIGIN=https://cms.grid.example.org

# PocketBase (cms)
# Set both before the first deploy so the admin account exists from the start.
PB_SUPERUSER_EMAIL=admin@example.org
PB_SUPERUSER_PASSWORD=
# 32 random characters; encrypts stored settings such as the S3 backup credentials
PB_ENCRYPTION_KEY=
# ^ exactly 32 characters: openssl rand -hex 16 (never change it once the CMS has run with it)
# Optional: space-separated IPs/subnets allowed to sign in as admin
PB_ADMIN_IPS=

# Restricted PocketBase account used by the Telegram bot (news only); password >= 16 characters
PB_BOT_EMAIL=bot@example.org
PB_BOT_PASSWORD=

# Telegram bot (Phase 1b)
TELEGRAM_BOT_TOKEN=000000000:replace-me
# Comma-separated numeric Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=

# Pipeline: 1 publishes the live outlook; 0 (default) writes a preview only
GRIDWATCH_PUBLISH=0

# Open-Meteo (only for a paid plan; the free API needs no key)
OPEN_METEO_API_KEY=

# Backups: PocketBase's S3 backups (e.g. Cloudflare R2) are set in its admin UI, not here;
# the credentials are stored encrypted with PB_ENCRYPTION_KEY. See deploy/README.md.
