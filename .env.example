# Copy to .env for local development. Placeholders only: never commit real values.
# In production these are set as Coolify environment variables.

# Public origins
SITE_ORIGIN=https://grid.example.org
CMS_ORIGIN=https://cms.grid.example.org

# PocketBase (cms)
PB_SUPERUSER_EMAIL=admin@example.org
PB_SUPERUSER_PASSWORD=

# Restricted PocketBase account used by the Telegram bot (news only)
PB_BOT_EMAIL=bot@example.org
PB_BOT_PASSWORD=

# Telegram bot (Phase 1b)
TELEGRAM_BOT_TOKEN=000000000:replace-me
# Comma-separated numeric Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=
# Only needed if the bot runs in webhook mode (long polling is the default)
TELEGRAM_WEBHOOK_SECRET=

# Open-Meteo (only for a paid plan; the free API needs no key)
OPEN_METEO_API_KEY=

# Off-VPS backups (S3-compatible storage for PocketBase and the forecast archive)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
