# Static server for the Grid Watch front end (spec 7.6).
# TLS and the public domain are handled by Coolify's proxy; this listens on :8080 inside.
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	# Security headers (spec 7.3, 9). The CSP is generated at build time (web/scripts/csp.mjs).
	import /etc/caddy/csp.caddy
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Runtime configuration for the page (web/src/lib/config.ts), from the environment
	handle /config.json {
		header Content-Type "application/json"
		header Cache-Control "no-cache"
		respond `\{"cmsOrigin":"{$CMS_ORIGIN:}"\}` 200
	}

	# Forecast data: pipeline output on the shared volume wins over the copy in the build,
	# so a daily run never needs a rebuild. Short cache (spec 7.6).
	@fromVolume {
		path /data/*
		file {
			root /var/lib/gridwatch
		}
	}
	handle @fromVolume {
		root * /var/lib/gridwatch
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}
	handle /data/* {
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	# Hashed build assets never change
	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	# No access log: it would record visitors' IP addresses (spec 9, privacy).
}
