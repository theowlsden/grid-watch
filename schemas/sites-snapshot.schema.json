{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grid.noirvisuals.studio/schemas/sites-snapshot.schema.json",
  "title": "Grid Watch sites and island snapshot",
  "description": "Committed export of the CMS sites and island records (spec 7.4). Used as the build fallback and as pipeline input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["exported_at", "island", "sites"],
  "properties": {
    "_comment": { "type": "string" },
    "exported_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "island": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "outline", "anchorLat", "anchorLon", "metresPerUnit", "rotation"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "outline": { "oneOf": [{ "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "const": "Polygon" } } }, { "type": "null" }] },
        "anchorLat": { "oneOf": [{ "type": "number", "minimum": 11, "maximum": 13 }, { "type": "null" }] },
        "anchorLon": { "oneOf": [{ "type": "number", "minimum": -70, "maximum": -68 }, { "type": "null" }] },
        "metresPerUnit": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }] },
        "rotation": { "type": "number" }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name_en", "name_pap", "kind", "parks", "lat", "lon", "placement", "enabled", "sortOrder"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name_en": { "type": "string", "minLength": 1 },
          "name_pap": { "type": ["string", "null"] },
          "kind": { "enum": ["wind", "thermal", "other"] },
          "parks": { "oneOf": [{ "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, { "type": "null" }] },
          "lat": { "oneOf": [{ "type": "number", "minimum": 11.9, "maximum": 12.5 }, { "type": "null" }], "description": "Curaçao bounding box, rounded to what the map needs." },
          "lon": { "oneOf": [{ "type": "number", "minimum": -69.3, "maximum": -68.6 }, { "type": "null" }] },
          "placement": { "enum": ["exact", "approximate"] },
          "enabled": { "type": "boolean" },
          "sortOrder": { "type": "integer" },
          "description_en": { "type": ["string", "null"] },
          "description_pap": { "type": ["string", "null"] },
          "pap_reviewed": { "type": "boolean" },
          "source_url": { "oneOf": [{ "type": "string", "pattern": "^https://" }, { "type": "null" }] },
          "source_note": { "type": ["string", "null"] },
          "modelOffset": { "oneOf": [{ "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, { "type": "null" }] },
          "modelRotation": { "type": ["number", "null"] },
          "placeholder_uv": { "oneOf": [{ "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, { "type": "null" }], "description": "Stylised position until lat/lon are projected." }
        }
      }
    }
  }
}
